# Скопируйте файл в docker/.env для локального переопределения настроек.
# Не добавляйте секретные значения в этот шаблон.
APP_PORT=8080
AGENT_MAX_ITERATIONS=4
LOG_LEVEL=INFO
LOG_FORMAT=human
LLM_MODEL=openai/replace-with-model
# LLM_API_KEY=replace-with-local-secret
# LLM_BASE_URL=https://llm.example.test/v1
LLM_TIMEOUT_SECONDS=60
LLM_NUM_RETRIES=0
# Обязательный секрет подписи JWT не короче 32 байт; значения с префиксом
# replace-with- отклоняются. Сгенерируйте: openssl rand -base64 48
AUTH_JWT_SECRET=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
# Включайте вместе с HTTPS.
AUTH_COOKIE_SECURE=false
# Ограничение частоты входа и регистрации (счётчики в Redis, окно фиксированное).
# Неудачные попытки пары «логин + IP»: число и окно.
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
# Запросы входа с одного IP.
AUTH_LOGIN_MAX_PER_IP=30
AUTH_LOGIN_PER_IP_WINDOW_SECONDS=60
# Запросы регистрации с одного IP.
AUTH_REGISTER_MAX_PER_IP=10
AUTH_REGISTER_PER_IP_WINDOW_SECONDS=3600
POSTGRES_USER=smeshariki
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=smeshariki
