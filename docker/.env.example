# Скопируйте файл в docker/.env для локального переопределения настроек.
# Не добавляйте секретные значения в этот шаблон.
APP_PORT=8080
AGENT_MAX_ITERATIONS=4
LOG_LEVEL=INFO
LOG_FORMAT=human
LLM_MODEL=openai/replace-with-model
# LLM_API_KEY=replace-with-local-secret
# LLM_BASE_URL=https://llm.example.test/v1
LLM_TIMEOUT_SECONDS=60
LLM_NUM_RETRIES=0
# Секрет подписи JWT не короче 32 байт, например: openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-local-secret-at-least-32-bytes
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
# Включайте вместе с HTTPS.
AUTH_COOKIE_SECURE=false
POSTGRES_USER=smeshariki
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=smeshariki
